{
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.2.3"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "metric-notes-grep": {
      "type": "stdio",
      "command": "python",
      "args": ["tools/metric-notes-grep/server.py"],
      "env": {
        "NOTES_ROOT": "."
      }
    }
  }
}
